[default]
; ------------------------------------------------
; ludus.nuketown (Ludus: localuser / password until domain provisioned)
; ------------------------------------------------
dc01 ansible_host={{ip_range}}.10 dns_domain=dc01 dict_key=dc01 ansible_user=localuser ansible_password=password
adfs ansible_host={{ip_range}}.11 dns_domain=dc01 dict_key=adfs ansible_user=localuser ansible_password=password
entraconnect ansible_host={{ip_range}}.12 dns_domain=dc01 dict_key=entraconnect ansible_user=localuser ansible_password=password
ws01 ansible_host={{ip_range}}.13 dns_domain=dc01 dict_key=ws01 ansible_user=localuser ansible_password=password
gitlab ansible_host={{ip_range}}.100 dict_key=gitlab ansible_user=debian ansible_password=debian ansible_connection=ssh ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[all:vars]
; domain_name : folder inside ad/
domain_name=ADFS

; winrm connection (windows)
ansible_winrm_transport=ntlm
ansible_user=notused
ansible_password=notused
ansible_connection=winrm
ansible_winrm_server_cert_validation=ignore
ansible_winrm_operation_timeout_sec=400
ansible_winrm_read_timeout_sec=500

; LAB SCENARIO CONFIGURATION -----------------------------
[domain]
dc01
adfs
entraconnect
ws01

[linux_domain]
gitlab
